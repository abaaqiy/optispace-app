# Copy to backend/.env and replace the username, password, host, port, and name.
# URL-encode special characters in credentials. Never use a VITE_ prefix here.
# Environment variables supplied by your deployment override this file.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Local development defaults. Production uses false and a generated secret.
DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=GENERATE_AT_LEAST_50_RANDOM_CHARACTERS
# DJANGO_ALLOWED_HOSTS=optispace.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://optispace.onrender.com
# Set true only behind a hosting proxy that controls X-Forwarded-Proto.
# DJANGO_TRUST_PROXY=true
